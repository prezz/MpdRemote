<?xml version="1.0" encoding="utf-8"?>
<!-- Single background for the whole app bar (status-bar strip + toolbar). A subtle diagonal
     gradient using dedicated dark colors so the bar stays dark independently of colorPrimary
     (which is the app's adaptive accent). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="45"
        android:startColor="@color/app_bar_gradient_start"
        android:endColor="@color/app_bar_gradient_end" />
</shape>
